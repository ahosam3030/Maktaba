DATABASE_URL="postgresql://library_user:change_this_password@localhost:5432/library_erp?schema=public"
PORT=3000
JWT_SECRET="replace-with-a-long-random-secret-before-deployment"

# مفتاح JWT (إلزامي في الإنتاج) — سلسلة طويلة عشوائية
JWT_SECRET="replace-with-a-long-random-secret-before-deployment"

# مفتاح AES-256 للبيانات الحساسة غير كلمات المرور (64 حرف hex أو أي نص طويل)
# openssl rand -hex 32
ENCRYPTION_KEY=""

# SETUP_SECRET=""  # اتركه فارغًا لإبقاء التسجيل العام مقفولًا

# Login rate limits (per window)
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_EMAIL=8
LOGIN_RATE_WINDOW_MS=900000

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# production: set NODE_ENV=production and terminate TLS at reverse proxy (Caddy/Nginx)
# NODE_ENV=production
# PORT=3000
