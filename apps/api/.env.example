DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/library_erp?schema=public"
PORT=3000

# إلزامي في الإنتاج — سلسلة طويلة عشوائية
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG!!"

# مفتاح AES-256 اختياري للبيانات الحساسة غير كلمات المرور (openssl rand -hex 32)
ENCRYPTION_KEY=""

# اتركه فارغًا لإبقاء التسجيل العام مقفولًا
# SETUP_SECRET=""

# حدود محاولات تسجيل الدخول
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_EMAIL=8
LOGIN_RATE_WINDOW_MS=900000

# أصول الواجهة المسموحة (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# للإنتاج: NODE_ENV=production و TLS عبر reverse proxy (Caddy/Nginx)
# NODE_ENV=production
