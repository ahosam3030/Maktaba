generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  phone            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  branches         Branch[]
  users            User[]
  suppliers        Supplier[]
  products         Product[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]
  stockMovements   StockMovement[]
  sales            Sale[]
  cashTransactions CashTransaction[]
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id               String            @id @default(cuid())
  organizationId   String
  fullName         String
  email            String            @unique
  passwordHash     String?
  /// OWNER | ADMIN | USER
  role             String            @default("OWNER")
  /// JSON array of permission keys, e.g. ["sales","inventory"]
  permissions      String            @default("[]")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashTransactions CashTransaction[]

  @@index([organizationId])
}

model Supplier {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  phone            String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]

  @@unique([organizationId, name])
  @@index([organizationId, name])
}

model Product {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  barcode        String?
  unit           String                @default("PIECE")
  piecesPerPack  Int                   @default(1)
  currentCost    Decimal               @default(0) @db.Decimal(12, 3)
  salePrice      Decimal               @default(0) @db.Decimal(12, 3)
  minStock       Decimal               @default(0) @db.Decimal(12, 3)
  imageUrl       String?
  notes          String?
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseItems  PurchaseInvoiceItem[]
  returnItems    PurchaseReturnItem[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([organizationId, name])
  @@index([organizationId, name])
  @@index([organizationId, barcode])
  @@index([organizationId, active])
}

model PurchaseInvoice {
  id             String                @id @default(cuid())
  organizationId String
  supplierId     String
  invoiceNumber  String
  invoiceDate    DateTime              @default(now())
  discount       Decimal               @default(0) @db.Decimal(12, 3)
  subtotal       Decimal               @default(0) @db.Decimal(12, 3)
  total          Decimal               @default(0) @db.Decimal(12, 3)
  paidAmount     Decimal               @default(0) @db.Decimal(12, 3)
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseInvoiceItem[]
  payments       SupplierPayment[]
  returns        PurchaseReturn[]

  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, supplierId])
}

model PurchaseInvoiceItem {
  id               String              @id @default(cuid())
  invoiceId        String
  productId        String
  productName      String
  unit             String
  quantity         Decimal             @db.Decimal(12, 3)
  unitCost         Decimal             @db.Decimal(12, 3)
  piecesPerPack    Int                 @default(1)
  lineTotal        Decimal             @db.Decimal(12, 3)
  returnedQuantity Decimal             @default(0) @db.Decimal(12, 3)
  invoice          PurchaseInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems      PurchaseReturnItem[]

  @@index([invoiceId])
  @@index([productId])
}

model SupplierPayment {
  id             String           @id @default(cuid())
  organizationId String
  supplierId     String
  invoiceId      String?
  amount         Decimal          @db.Decimal(12, 3)
  paymentDate    DateTime         @default(now())
  method         String           @default("CASH")
  notes          String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoice        PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, supplierId, paymentDate])
  @@index([invoiceId])
}

model PurchaseReturn {
  id             String               @id @default(cuid())
  organizationId String
  supplierId     String
  invoiceId      String
  returnNumber   String?
  returnDate     DateTime             @default(now())
  total          Decimal              @db.Decimal(12, 3)
  reason         String?
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoice        PurchaseInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  items          PurchaseReturnItem[]

  @@index([organizationId, returnDate])
  @@index([invoiceId])
}

model PurchaseReturnItem {
  id             String              @id @default(cuid())
  returnId       String
  invoiceItemId  String
  productId      String
  quantity       Decimal             @db.Decimal(12, 3)
  unitCost       Decimal             @db.Decimal(12, 3)
  lineTotal      Decimal             @db.Decimal(12, 3)
  purchaseReturn PurchaseReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItem    PurchaseInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([invoiceItemId])
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  productId      String
  quantity       Decimal      @db.Decimal(12, 3)
  type           String       @default("ADJUSTMENT")
  reason         String
  notes          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([organizationId, type])
}

model Sale {
  id             String       @id @default(cuid())
  organizationId String
  invoiceNumber  String
  saleDate       DateTime     @default(now())
  customerName   String?
  subtotal       Decimal      @db.Decimal(12, 3)
  discount       Decimal      @default(0) @db.Decimal(12, 3)
  total          Decimal      @db.Decimal(12, 3)
  paidAmount     Decimal      @default(0) @db.Decimal(12, 3)
  notes          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          SaleItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, saleDate])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String?  // null = بند خدمة/وصف حر بدون مخزون
  productName String
  unit        String?  // قطعة، خدمة، ...
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 3)
  unitCost    Decimal @default(0) @db.Decimal(12, 3)
  lineTotal   Decimal @db.Decimal(12, 3)
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model CashTransaction {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  date           DateTime     @default(now())
  category       String
  amount         Decimal      @db.Decimal(12, 3)
  method         String       @default("CASH")
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, date])
  @@index([organizationId, kind, date])
  @@index([organizationId, category])
}
